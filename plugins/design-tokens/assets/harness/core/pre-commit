#!/bin/sh
# The design-token commit gate for a person in the terminal: the same
# `beforeCommit` commands an agent's commit runs (design-system/gates.json).
# Installed into the project's git hooks folder; when the project already has
# a pre-commit hook, add the last line to it instead of replacing it.
set -e
cd "$(git rev-parse --show-toplevel)"
if ! command -v node >/dev/null 2>&1; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  # shellcheck disable=SC1091
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 && nvm use --silent >/dev/null 2>&1
fi
node .claude/hooks/design-tokens/run-gates.mjs before-commit
