{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design-tokens/with-node.sh protect-generated.mjs",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design-tokens/with-node.sh guard-commit.mjs",
            "timeout": 300,
            "statusMessage": "Design-token gates before the commit…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design-tokens/with-node.sh check-on-edit.mjs",
            "timeout": 120,
            "statusMessage": "Design-token checks on the edited file…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design-tokens/with-node.sh check-after-bash.mjs",
            "timeout": 120,
            "statusMessage": "Design-token checks on the files the command changed…"
          }
        ]
      }
    ]
  }
}
